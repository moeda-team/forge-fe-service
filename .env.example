# Public URL of the Forge backend. Do not append /api or a trailing slash.
# NEXT_PUBLIC_FORGE_API_URL=http://localhost:4000

# Environment variables for Forge BE Service
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
API_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forge?schema=public

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=false

# MinIO
MINIO_ENDPOINT=http://localhost
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your_admin_user
MINIO_SECRET_KEY=your_strong_password
MINIO_BUCKET=forge
UPLOAD_MAX_BYTES=10485760

# Forge frontend API connection
NEXT_PUBLIC_FORGE_API_URL=http://localhost:4000
